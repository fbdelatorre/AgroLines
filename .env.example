# Copie para .env e preencha localmente; nunca versione credenciais reais.
POSTGRES_PASSWORD=
# Use a mesma senha acima, com caracteres especiais codificados para URL.
AGROLINES_DATABASE_URL=
# Formato: postgresql+psycopg://agrolines:SENHA@db:5432/agrolines
# Opções do servidor (no Compose, só variáveis explicitamente mapeadas são injetadas):
AGROLINES_ACCESS_TTL=900
AGROLINES_REFRESH_TTL=86400
AGROLINES_LOGIN_LIMIT=10
AGROLINES_LOGIN_WINDOW=900
# Recuperação opcional: STARTTLS obrigatório, valores reais apenas em configuração segura.
# AGROLINES_SMTP_HOST=
# AGROLINES_SMTP_PORT=587
# AGROLINES_SMTP_FROM=
# AGROLINES_SMTP_USERNAME=
# AGROLINES_SMTP_PASSWORD=

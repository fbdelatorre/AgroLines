FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY server ./server
COPY core ./core
COPY desktop ./desktop
COPY exporters ./exporters
COPY infra/licensing-requirements.lock ./licensing-requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r licensing-requirements.lock
RUN pip install --no-cache-dir --no-deps .
RUN useradd --create-home agrolines && chmod -R a+rX /app
USER agrolines
EXPOSE 8001
CMD ["uvicorn", "server.license_runtime:application", "--factory", "--host", "0.0.0.0", "--port", "8001", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
